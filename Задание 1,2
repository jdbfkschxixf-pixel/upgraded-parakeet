import tkinter as tk

window = tk.Tk()
window.title("Регистрация")
window.geometry("1000x650")

title_label = tk.Label(
window,
text="Магазин BURMOLDA",
font=("Arial", 20, "bold")
)
title_label.pack(pady=(30, 20))

frame = tk.Frame(window)
frame.pack(pady=10)

login_label = tk.Label(
    frame,
    text="Логин пользователя",
    font=("Arial", 10)
)
login_label.pack(side="left", padx=10)

entry = tk.Entry(frame, font=("Arial", 10), width=20)
entry.pack(side="left")

def on_click():
    print(f"Введён логин: {entry.get()}")

button = tk.Button(
    window,
    text="Войти в систему",
    font=("Arial", 10),
    command=on_click,
    relief="solid",
    borderwidth=2
)
button.pack(pady=15, ipadx=20, ipady=5)

window.mainloop()
import tkinter as tk

window = tk.Tk()
window.title("Каталог")
window.geometry("1000x650")

title_label = tk.Label(
window,
text="Магазин BURMOLDA",
font=("Arial", 20, "bold")
)
title_label.pack(pady=(30, 20))

def create_card(parent):

    card = tk.Frame(
        parent,
        highlightbackground="black",
        highlightthickness=2,
        bd=0
    )
    card.pack(pady=15, padx=40, fill="x")

    photo = tk.Frame(
        card,
        width=100,
        height=100,
        highlightbackground="black",
        highlightthickness=2
    )
    photo.pack(side="left", padx=15, pady=15)
    photo.pack_propagate(False)  

    photo_label = tk.Label(
        photo,
        text="ФОТО",
        font=("Arial", 14, "bold")
    )
    photo_label.place(relx=0.5, rely=0.5, anchor="center")

    info = tk.Frame(card)
    info.pack(side="left", fill="both", expand=True, padx=10, pady=10)

    top_row = tk.Frame(info)
    top_row.pack(anchor="w", pady=(0, 10))

    tk.Label(top_row, text="Производство", font=("Arial", 14, "bold")).pack(side="left")
    tk.Label(top_row, text=" | ", font=("Arial", 14, "bold")).pack(side="left")
    tk.Label(top_row, text="Название", font=("Arial", 14, "bold")).pack(side="left")

    for text in ["Категория", "Количество", "Состав"]:
        tk.Label(info, text=text, font=("Arial", 13), anchor="w").pack(fill="x", pady=2)

    tk.Label(info, text="Цена:", font=("Arial", 14, "bold"), anchor="e").pack(fill="x", pady=(10, 0))

    return card

create_card(window)
create_card(window)

window.mainloop()
